{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/class-schedules/[id]",
      "regex": "^/api/class\\-schedules/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/class\\-schedules/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/class-schedules/[id]/add-to-calendar",
      "regex": "^/api/class\\-schedules/([^/]+?)/add\\-to\\-calendar(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/class\\-schedules/(?<nxtPid>[^/]+?)/add\\-to\\-calendar(?:/)?$"
    },
    {
      "page": "/api/events/[id]",
